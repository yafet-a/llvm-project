; RUN: opt < %s -disable-output "-passes=print<da>" -aa-pipeline=basic-aa 2>&1 \
; RUN: | FileCheck %s

@A = global [150 x [150 x double]] zeroinitializer
@B = global [150 x [150 x double]] zeroinitializer

; A(lb0:ub0, lb1:ub1) with runtime bounds in both dimensions: the leading
; extent is smax(ub0 - lb0, -1) + 1. Recovering the sizes from the parametric
; terms of the strides keeps only smax(ub0 - lb0, -1) and loses the "+ 1", so
; the outer subscript stays entangled with the inner loop. Recovering them as
; the ratio of the per-loop strides keeps the whole extent, and with the
; in-range guarantee the dependence is exact.
define void @lower_bounds(ptr noalias %A, i64 %lb0, i64 %ub0, i64 %lb1,
;
; CHECK-LABEL: 'lower_bounds'
; CHECK-NEXT:  Src: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr %A, i64 %ext, i64 %ext1) ] --> Dst: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr %A, i64 %ext, i64 %ext1) ]
; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr %A, i64 %ext, i64 %ext1) ] --> Dst: %v = load double, ptr %p, align 8
; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr %A, i64 %ext, i64 %ext1) ] --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: %v = load double, ptr %p, align 8 --> Dst: %v = load double, ptr %p, align 8
; CHECK-NEXT:    da analyze - none!
; CHECK-NEXT:  Src: %v = load double, ptr %p, align 8 --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - anti [0 0|<]!
; CHECK-NEXT:  Src: store double %w, ptr %p, align 8 --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - none!
;
                          i64 %ilo, i64 %ihi, i64 %klo, i64 %khi) {
entry:
  %span = sub nsw i64 %ub0, %lb0
  %clamp = call i64 @llvm.smax.i64(i64 %span, i64 -1)
  %ext = add nsw i64 %clamp, 1
  %span1 = sub nsw i64 %khi, %lb1
  %ext1 = add nsw i64 %span1, 1
  br label %outer

outer:
  %k = phi i64 [ %klo, %entry ], [ %k.next, %outer.latch ]
  %kr = sub nsw i64 %k, %lb1
  %off = mul nuw nsw i64 %kr, %ext
  %row = getelementptr nusw [8 x i8], ptr %A, i64 %off
  br label %inner

inner:
  %i = phi i64 [ %ilo, %outer ], [ %i.next, %inner ]
  %ir = sub nsw i64 %i, %lb0
  %p = getelementptr nusw [8 x i8], ptr %row, i64 %ir
  call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr %A, i64 %ext, i64 %ext1) ]
  %v = load double, ptr %p, align 8
  %w = fmul double %v, 2.0
  store double %w, ptr %p, align 8
  %i.next = add nsw i64 %i, 1
  %i.done = icmp eq i64 %i, %ihi
  br i1 %i.done, label %outer.latch, label %inner

outer.latch:
  %k.next = add nsw i64 %k, 1
  %k.done = icmp eq i64 %k, %khi
  br i1 %k.done, label %exit, label %outer

exit:
  ret void
}

; A(j, i) = A(j, i) * 2 through the flattened address of a 150 x 150 array,
; with trip counts that are arguments. Nothing in the IR stops j from running
; past 150, so without the in-range guarantee (i, j) and (i+1, j-150) could
; name the same element and the dependence stays conservative. The guarantee
; rules that out; the recovered unit-stride subscripts must then keep
; no-signed-wrap for the dependence to be exact.
define void @runtime_bounds(i32 %n32, i32 %m32) {
;
; CHECK-LABEL: 'runtime_bounds'
; CHECK-NEXT:  Src: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr @A, i64 150, i64 150) ] --> Dst: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr @A, i64 150, i64 150) ]
; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr @A, i64 150, i64 150) ] --> Dst: %v = load double, ptr %p, align 8
; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr @A, i64 150, i64 150) ] --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: %v = load double, ptr %p, align 8 --> Dst: %v = load double, ptr %p, align 8
; CHECK-NEXT:    da analyze - none!
; CHECK-NEXT:  Src: %v = load double, ptr %p, align 8 --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - anti [0 0|<]!
; CHECK-NEXT:  Src: store double %w, ptr %p, align 8 --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - none!
;
entry:
  %n.pos = icmp sgt i32 %n32, 0
  %m.pos = icmp sgt i32 %m32, 0
  %ok = and i1 %n.pos, %m.pos
  br i1 %ok, label %preheader, label %exit

preheader:
  %n = zext nneg i32 %n32 to i64
  %m = zext nneg i32 %m32 to i64
  br label %outer

outer:
  %i = phi i64 [ 1, %preheader ], [ %i.next, %outer.latch ]
  %row = mul nuw nsw i64 %i, 150
  %base = add i64 %row, -151
  br label %inner

inner:
  %j = phi i64 [ 1, %outer ], [ %j.next, %inner ]
  %idx = add i64 %j, %base
  %p = getelementptr nusw nuw [8 x i8], ptr @A, i64 %idx
  call void @llvm.assume(i1 true) [ "array.extents"(ptr %p, ptr @A, i64 150, i64 150) ]
  %v = load double, ptr %p, align 8
  %w = fmul double %v, 2.0
  store double %w, ptr %p, align 8
  %j.next = add nuw nsw i64 %j, 1
  %j.done = icmp eq i64 %j, %m
  br i1 %j.done, label %outer.latch, label %inner

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.done = icmp eq i64 %i, %n
  br i1 %i.done, label %exit, label %outer

exit:
  ret void
}

; The same access with constant trip counts, which the range check can bound
; on its own. Marking it must not make the analysis less precise than leaving
; it unmarked, even though the guarantee skips that range check.
define void @constant_bounds() {
;
