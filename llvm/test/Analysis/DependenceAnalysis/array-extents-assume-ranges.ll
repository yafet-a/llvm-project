; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: call void @llvm.assume(i1 true) [ "array.extents"(ptr %pb, ptr %B, i64 %m, i64 %n), "array.strides"(ptr %pb, i64 %sBj, i64 %sBi) ] --> Dst: store float %sub, ptr %pa, align 4
