; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -disable-output "-passes=print<da>" -aa-pipeline=basic-aa 2>&1 \
; RUN: | FileCheck %s

; A(i, j) = A(i, j) - z * B(i, j) on descriptor-based arrays, whose
; per-dimension strides are opaque runtime values. Delinearization cannot
; recover the shape, and the offset cannot even be shown to be a multiple of
; the element size without runtime assumptions. The in-range guarantee alone
; does not make that linearization injective, since the opaque strides may
; overlap, so the self-dependence stays conservative.
define void @descriptor_rmw(ptr noalias %A, ptr noalias %B, i64 %sAi, i64 %sAj,
; CHECK-LABEL: 'descriptor_rmw'
; CHECK-NEXT:  Src: %a = load float, ptr %pa, align 4 --> Dst: %a = load float, ptr %pa, align 4
; CHECK-NEXT:    da analyze - input [* *]!
; CHECK-NEXT:    Runtime Assumptions:
; CHECK-NEXT:    Equal predicate: (zext i2 {{\{\{}}0,+,(trunc i64 %sAi to i2)}<%outer>,+,(trunc i64 %sAj to i2)}<%inner> to i64) == 0
; CHECK-NEXT:  Src: %a = load float, ptr %pa, align 4 --> Dst: %b = load float, ptr %pb, align 4
; CHECK-NEXT:    da analyze - none!
; CHECK-NEXT:  Src: %a = load float, ptr %pa, align 4 --> Dst: store float %sub, ptr %pa, align 4
; CHECK-NEXT:    da analyze - anti [* *|<]!
; CHECK-NEXT:    Runtime Assumptions:
; CHECK-NEXT:    Equal predicate: (zext i2 {{\{\{}}0,+,(trunc i64 %sAi to i2)}<%outer>,+,(trunc i64 %sAj to i2)}<%inner> to i64) == 0
; CHECK-NEXT:  Src: %b = load float, ptr %pb, align 4 --> Dst: %b = load float, ptr %pb, align 4
; CHECK-NEXT:    da analyze - input [* *]!
; CHECK-NEXT:    Runtime Assumptions:
; CHECK-NEXT:    Equal predicate: (zext i2 {{\{\{}}0,+,(trunc i64 %sBi to i2)}<%outer>,+,(trunc i64 %sBj to i2)}<%inner> to i64) == 0
; CHECK-NEXT:  Src: %b = load float, ptr %pb, align 4 --> Dst: store float %sub, ptr %pa, align 4
; CHECK-NEXT:    da analyze - none!
; CHECK-NEXT:  Src: store float %sub, ptr %pa, align 4 --> Dst: store float %sub, ptr %pa, align 4
; CHECK-NEXT:    da analyze - output [* *]!
; CHECK-NEXT:    Runtime Assumptions:
; CHECK-NEXT:    Equal predicate: (zext i2 {{\{\{}}0,+,(trunc i64 %sAi to i2)}<%outer>,+,(trunc i64 %sAj to i2)}<%inner> to i64) == 0
;
                            i64 %sBi, i64 %sBj, i64 %n, i64 %m, float %z) {
entry:
  %A.c = call ptr @llvm.assume.chained.p0(ptr %A)
      [ "array.extents"(i64 %m, i64 %n), "array.strides"(i64 %sAj, i64 %sAi) ]
  %B.c = call ptr @llvm.assume.chained.p0(ptr %B)
      [ "array.extents"(i64 %m, i64 %n), "array.strides"(i64 %sBj, i64 %sBi) ]
  br label %outer

outer:
  %i = phi i64 [ 1, %entry ], [ %i.next, %outer.latch ]
  %im1 = add nsw i64 %i, -1
  %aioff = mul nsw i64 %sAi, %im1
  %arow = getelementptr i8, ptr %A.c, i64 %aioff
  %bioff = mul nsw i64 %sBi, %im1
  %brow = getelementptr i8, ptr %B.c, i64 %bioff
  br label %inner

inner:
  %j = phi i64 [ 1, %outer ], [ %j.next, %inner ]
  %jm1 = add nsw i64 %j, -1
  %ajoff = mul nsw i64 %jm1, %sAj
  %pa = getelementptr i8, ptr %arow, i64 %ajoff
  %a = load float, ptr %pa, align 4
  %bjoff = mul nsw i64 %jm1, %sBj
  %pb = getelementptr i8, ptr %brow, i64 %bjoff
  %b = load float, ptr %pb, align 4
  %mul = fmul float %b, %z
  %sub = fsub float %a, %mul
  store float %sub, ptr %pa, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.done = icmp eq i64 %j, %m
  br i1 %j.done, label %outer.latch, label %inner

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.done = icmp eq i64 %i, %n
  br i1 %i.done, label %exit, label %outer

exit:
  ret void
}

; The start of j varies with the parent loop, so different parent iterations
; may reach one element in different j iterations. Only the k loop, whose
; start is invariant in the nest, is proved equal.
define void @dynamic_outer_start(ptr %a, ptr %steps) {
; CHECK-LABEL: 'dynamic_outer_start'
; CHECK-NEXT:  Src: store double 0.000000e+00, ptr %gep, align 8 --> Dst: store double 0.000000e+00, ptr %gep, align 8
; CHECK-NEXT:    da analyze - output [* * 0]!
; CHECK-NEXT:  Src: store double 0.000000e+00, ptr %gep, align 8 --> Dst: %step = load i64, ptr %step.ptr, align 8
; CHECK-NEXT:    da analyze - confused!
; CHECK-NEXT:  Src: %step = load i64, ptr %step.ptr, align 8 --> Dst: %step = load i64, ptr %step.ptr, align 8
; CHECK-NEXT:    da analyze - none!
;
entry:
  %a.c = call ptr @llvm.assume.chained.p0(ptr %a)
      [ "array.extents"(i64 150, i64 33) ]
  br label %parent

parent:
  %p = phi i64 [ 0, %entry ], [ %p.next, %parent.latch ]
  %base = phi i64 [ 1, %entry ], [ %base.next, %parent.latch ]
  %j.end = add nsw i64 %base, 150
  br label %middle

middle:
  %j = phi i64 [ %base, %parent ], [ %j.next, %middle.latch ]
  br label %inner

inner:
  %k = phi i64 [ 0, %middle ], [ %k.next, %inner ]
  %j.zero = add nsw i64 %j, -1
  %j.bytes = mul nsw i64 %j.zero, 8
  %k.bytes = mul nsw i64 %k, 1200
  %offset = add nsw i64 %j.bytes, %k.bytes
  %gep = getelementptr i8, ptr %a.c, i64 %offset
  store double 0.0, ptr %gep, align 8
  %k.next = add nuw nsw i64 %k, 1
  %k.exit = icmp eq i64 %k.next, 33
  br i1 %k.exit, label %middle.latch, label %inner

middle.latch:
  %j.next = add nuw nsw i64 %j, 1
  %j.exit = icmp eq i64 %j.next, %j.end
  br i1 %j.exit, label %parent.latch, label %middle

parent.latch:
  %step.ptr = getelementptr i64, ptr %steps, i64 %p
  %step = load i64, ptr %step.ptr, align 8
  %base.next = add nsw i64 %base, %step
  %p.next = add nuw nsw i64 %p, 1
  %p.exit = icmp eq i64 %p.next, 2
  br i1 %p.exit, label %return, label %parent

return:
  ret void
}

declare ptr @llvm.assume.chained.p0(ptr)
