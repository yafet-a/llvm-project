; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes="print<cost-model>" 2>&1 -disable-output -cost-kind=all -mtriple=aarch64 < %s | FileCheck %s

; llvm.assume.chained returns its operand, so a GEP through its result must be
; costed like a GEP on the operand. A variable index on a global base cannot be
; folded into the addressing mode.

target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
target triple = "aarch64-linux-gnu"

@g = global [16 x i32] zeroinitializer

define i32 @global_base(i64 %i) {
; CHECK-LABEL: 'global_base'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %a = getelementptr [4 x i8], ptr @g, i64 %i
; CHECK-NEXT:  Cost Model: Found costs of RThru:1 CodeSize:1 Lat:4 SizeLat:1 for: %v = load i32, ptr %a, align 4
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i32 %v
;
  %a = getelementptr [4 x i8], ptr @g, i64 %i
  %v = load i32, ptr %a
  ret i32 %v
}

define i32 @chained_global_base(i64 %i) {
; CHECK-LABEL: 'chained_global_base'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %c = call ptr @llvm.assume.chained.p0(ptr @g) [ "array.extents"(i64 16) ]
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %a = getelementptr [4 x i8], ptr %c, i64 %i
; CHECK-NEXT:  Cost Model: Found costs of RThru:1 CodeSize:1 Lat:4 SizeLat:1 for: %v = load i32, ptr %a, align 4
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i32 %v
;
  %c = call ptr @llvm.assume.chained.p0(ptr @g) [ "array.extents"(i64 16) ]
  %a = getelementptr [4 x i8], ptr %c, i64 %i
  %v = load i32, ptr %a
  ret i32 %v
}

define i32 @chained_arg_base(ptr %p, i64 %i) {
; CHECK-LABEL: 'chained_arg_base'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %c = call ptr @llvm.assume.chained.p0(ptr %p) [ "array.extents"(i64 16) ]
; CHECK-NEXT:  Cost Model: Found costs of 0 for: %a = getelementptr [4 x i8], ptr %c, i64 %i
; CHECK-NEXT:  Cost Model: Found costs of RThru:1 CodeSize:1 Lat:4 SizeLat:1 for: %v = load i32, ptr %a, align 4
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i32 %v
;
  %c = call ptr @llvm.assume.chained.p0(ptr %p) [ "array.extents"(i64 16) ]
  %a = getelementptr [4 x i8], ptr %c, i64 %i
  %v = load i32, ptr %a
  ret i32 %v
}

declare ptr @llvm.assume.chained.p0(ptr)
