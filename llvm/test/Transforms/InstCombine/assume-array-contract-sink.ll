; Sinking a value drops its droppable uses outside the destination block, which
; would turn a whole array contract bundle into "ignore". Values used by array
; contract bundles must therefore stay where those bundles can still see them.

declare void @llvm.assume(i1)
declare void @use(i64)

define void @keep_extent_load(ptr %desc, ptr %base, i1 %c, i64 %i) {
; CHECK-LABEL: define void @keep_extent_load(
; CHECK-SAME: ptr [[DESC:%.*]], ptr [[BASE:%.*]], i1 [[C:%.*]], i64 [[I:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[EXT:%.*]] = load i64, ptr [[DESC]], align 8
; CHECK-NEXT:    br i1 [[C]], label %[[USE:.*]], label %[[OTHER:.*]]
; CHECK:       [[USE]]:
; CHECK-NEXT:    call void @use(i64 [[EXT]])
; CHECK-NEXT:    ret void
; CHECK:       [[OTHER]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr [8 x i8], ptr [[BASE]], i64 [[I]]
; CHECK-NEXT:    call void @llvm.assume(i1 true) [ "array.extents"(ptr [[GEP]], ptr [[BASE]], i64 [[EXT]]) ]
; CHECK-NEXT:    store double 0.000000e+00, ptr [[GEP]], align 8
; CHECK-NEXT:    ret void
;
entry:
  %ext = load i64, ptr %desc, align 8
  br i1 %c, label %use, label %other

use:
  call void @use(i64 %ext)
  ret void

other:
  %gep = getelementptr [8 x i8], ptr %base, i64 %i
  call void @llvm.assume(i1 true) [ "array.extents"(ptr %gep, ptr %base, i64 %ext) ]
  store double 0.0, ptr %gep, align 8
  ret void
}
